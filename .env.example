# ─────────────────────────────────────────────────────────────
#  Movie Ticket Booking — environment configuration
#  Copy this file to `.env` and adjust the values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Which config profile to load: development | testing | production
FLASK_CONFIG=development
FLASK_APP=wsgi.py

# Secret key for signing sessions/CSRF tokens.
# Generate a strong one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database connection string.
# Default (leave unset) uses a local SQLite file at instance/app.db
# MySQL example:     mysql+pymysql://user:password@localhost/dbname
# PostgreSQL example: postgresql+psycopg://user:password@localhost/dbname
# DATABASE_URL=

# Send cookies only over HTTPS (set to true in production behind TLS)
SESSION_COOKIE_SECURE=false

# Branding shown in the UI / footer
PROJECT_NAME=CineBook
THEATRE_NAME=Pallavan Theatre

# Pagination
BOOKINGS_PER_PAGE=8
